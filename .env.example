# Veylor SSO Environment Configuration

# Environment mode: development | production | test
SSO_ENV=development

# The public issuer URL. MUST match the exact base URL of this SSO service.
# Production example: https://sso.veylor.dev
SSO_ISSUER=http://localhost:8000

# Secret key for internal integrity and CSRF signing
SECRET_KEY=veylor_dev_secret_change_in_production_32_chars_min!

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=veylor_sso

# Redis Configuration (Optional / recommended for distributed rate limiting & session cache)
REDIS_URL=redis://localhost:6379/0

# Session Configuration
SESSION_COOKIE_NAME=veylor_session
SESSION_TTL_SECONDS=2592000
# Set SESSION_COOKIE_SECURE to true in production (HTTPS required)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# OAuth / OIDC Configuration
ACCESS_TOKEN_TTL_SECONDS=3600
AUTHORIZATION_CODE_TTL_SECONDS=60
SIGNING_KEY_PATH=keys/private_key.pem

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://egarageapp.uk

# Admin API Key (used for protecting /api/admin/* endpoints)
ADMIN_API_KEY=veylor_admin_secret_key_change_me_in_prod

# Email / SMTP Configuration (defaults to Mailpit local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=true
SMTP_FROM_EMAIL=contact@veylor.dev
SMTP_FROM_NAME="Veylor Systems"

# Password Reset & Email Verification Token TTL
PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_VERIFICATION_TTL_SECONDS=86400
